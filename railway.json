{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "bash build.sh",
    "watchPatterns": [
      "requirements.txt",
      "build.sh",
      "**/*.py",
      "**/*.html",
      "**/*.css",
      "**/*.js"
    ]
  },
  "deploy": {
    "startCommand": "gunicorn bklbusiness.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --timeout 120 --log-level info",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}

