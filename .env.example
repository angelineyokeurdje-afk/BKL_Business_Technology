# Django Configuration
DJANGO_SECRET_KEY=your-secure-secret-key-here-generate-one-with-django-core-management-utils-get_random_secret_key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app

# Database (Railway provides DATABASE_URL automatically)
# For local development with PostgreSQL:
DATABASE_URL=postgresql://user:password@localhost:5432/bklbusiness_db

# Railway Environment Detection (auto-set by Railway)
# RAILWAY_ENVIRONMENT=production
# RAILWAY_SERVICE_ID=your-service-id
# RAILWAY_PUBLIC_DOMAIN=your-app.railway.app

# Admin User Creation (used during deployment)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-secure-admin-password

# Email Configuration (for password reset, notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@bkl-business.com

# Cloudinary (Optional - for image storage)
# USE_CLOUDINARY=true
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Redis/Cache (Optional - Railway Redis support)
# REDIS_URL=redis://user:password@host:port/0

# Locale & Timezone
LANGUAGE_CODE=fr-fr
TIME_ZONE=Africa/Douala
